#Область ПоискСозданияОбъектаРС  

Функция НайтиОбъектРС(Вид, Имя) Экспорт
	
	ПоискОбъект = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	рс_Объекты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.рс_Объекты КАК рс_Объекты
		|ГДЕ
		|	рс_Объекты.Вид = &Вид
		|	И рс_Объекты.Индентификатор = &Имя
		|	И рс_Объекты.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Вид"	, Вид);
	Запрос.УстановитьПараметр("Имя"	, Имя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоискОбъект = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат ПоискОбъект;
	
КонецФункции 

Функция СоздатьОбъектРС(Структура)  Экспорт 
	 
	НовОбъект = Справочники.рс_Объекты.СоздатьЭлемент();	
	НовОбъект.Индентификатор 	= Структура.Индентификатор;
	НовОбъект.Наименование  	= Структура.Наименование; 
	НовОбъект.Вид            	= Структура.Вид; 
	
	ИмяТипа 					= рс_ОбщийМодульСервер.ИмяТипаМетаданныхДляФормы(Строка(Структура.Вид));
   	ПолноеИмя 					= ИмяТипа + "." + Структура.Индентификатор;  
	
	НовОбъект.ОбъектБД          = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", ПолноеИмя);
	
	НовОбъект.Записать();
	
	ЗаполнитьРеквизитыОбъектаРС(НовОбъект.Ссылка);

	Возврат НовОбъект.Ссылка;
	
КонецФункции

Процедура ЗаполнитьРеквизитыОбъектаРС(Ссылка) Экспорт
	 
	Если Строка(Ссылка.Вид) = "Регистры сведений" Или Строка(Ссылка.Вид) = "Регистры накопления" Или Строка(Ссылка.Вид) = "Отчеты" Тогда 
		Возврат;
	КонецЕсли;
	
	СпрОбъект = Ссылка.ПолучитьОбъект(); 	
	СпрОбъект.рс_Реквизиты.Очистить(); 
		
	ИмяКоллекции = ИмяКоллекцииМетаданныхПоВиду(СпрОбъект.Вид);
	
	Структура = Новый Структура; 
	Структура.Вставить("тВид"	, ИмяКоллекции);
	Структура.Вставить("ИД"		, СпрОбъект.Индентификатор);
	Структура.Вставить("Табл"	, СпрОбъект.рс_Реквизиты);
	Структура.Вставить("ТЧ"		, Неопределено);
	
	//ТЧ Реквизиты
	//Реквизиты Объекта
	ЗаполнитьРеквизитыРС(Структура); 
	
	//ТЧ Реквизиты
	//Реквизиты Табличные части Объекта
	Для Каждого ТабЧасть Из Метаданные[Структура.тВид][Структура.ИД].ТабличныеЧасти Цикл 
		ИмяТЧ 		= ТабЧасть.Имя;
		ТабЧасть 	= Справочники.рс_ТабличныеЧасти.НайтиПоНаименованию(ИмяТЧ);
		
		Если Не ЗначениеЗаполнено(ТабЧасть) Тогда 
			ТабЧасть = СоздатьТабличныеЧастиРС(ИмяТЧ);
		КонецЕсли;
		
		Структура.Вставить("ТЧ"		, ТабЧасть);
		
		ЗаполнитьРеквизитыРС(Структура);
	КонецЦикла;	
	
	//ТЧ Формы ??
	СпрОбъект.рс_Формы.Очистить();
	Для Каждого Метаданное Из Метаданные[Структура.тВид][Структура.ИД].Формы Цикл
		НоваяСтрока = СпрОбъект.рс_Формы.Добавить();
		ИмяФормы 	= Метаданное.Имя;
		рсФорма		= Справочники.рс_Формы.НайтиПоНаименованию(ИмяФормы); 
		
		Если Не ЗначениеЗаполнено(рсФорма) Тогда 
			рсФорма = СоздатьФормуРС(ИмяФормы);
		КонецЕсли;
		
		НоваяСтрока.рс_Форма 	= рсФорма;
	КонецЦикла;
	
	СпрОбъект.Записать();
		
КонецПроцедуры

Процедура ЗаполнитьРеквизитыРС(Структура) Экспорт

	МетаданныеОбъекта = Метаданные[Структура.тВид][Структура.ИД];
	
	Если Структура.ТЧ = Неопределено Тогда
		КоллекцияРеквизитов = МетаданныеОбъекта.Реквизиты;
		ТабличнаяЧастьСсылка = Неопределено;
	Иначе
		ИмяТЧ = Структура.ТЧ.Наименование;
		МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаданныеТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		КоллекцияРеквизитов = МетаданныеТЧ.Реквизиты;
		ТабличнаяЧастьСсылка = Структура.ТЧ;
	КонецЕсли;
	
	Для Каждого Метаданное Из КоллекцияРеквизитов Цикл
		НовСтрока = Структура.Табл.Добавить();
		СтрокаТипа = СтрокаТипаИзОписанияТипа(Метаданное.Тип);
		НовСтрока.Имя = ПолучитьСсылкуРеквизита(Метаданное.Имя, Метаданное.Синоним, СтрокаТипа);
		
		Если Метаданное.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда 
			НовСтрока.Обязательный = Истина;
		КонецЕсли;  
		
		Попытка 
			поискИОМ = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя",СтрокаТипа); 
		Исключение
		КонецПопытки;
		
		Если ЗначениеЗаполнено(поискИОМ) Тогда 
			НовСтрока.ТипОбъектовМетаданных = поискИОМ;
		КонецЕсли;
		
		Если ТабличнаяЧастьСсылка <> Неопределено Тогда
			НовСтрока.рс_ТабличнаяЧасть = ТабличнаяЧастьСсылка;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СоздатьТабличныеЧастиРС(ИмяТЧ)
	 СправочникСсылка = Справочники.рс_ТабличныеЧасти.ПустаяСсылка();
	 
	 СправочникОбъект = Справочники.рс_ТабличныеЧасти.СоздатьЭлемент();
	 СправочникОбъект.Наименование = ИмяТЧ;
	 СправочникОбъект.Записать();
	 СправочникСсылка = СправочникОбъект.Ссылка;
	 
	 Возврат СправочникСсылка;
 КонецФункции
 
Функция СоздатьФормуРС(ИмяФормы)
	 СправочникСсылка = Справочники.рс_Формы.ПустаяСсылка();
	 
	 СправочникОбъект = Справочники.рс_Формы.СоздатьЭлемент();
	 СправочникОбъект.Наименование = ИмяФормы;
	 СправочникОбъект.Записать();
	 СправочникСсылка = СправочникОбъект.Ссылка;
	 
	 Возврат СправочникСсылка;
 КонецФункции

#КонецОбласти 

Функция ИмяКоллекцииМетаданныхПоВиду(Вид) Экспорт
	
	ИмяВида = Строка(Вид);
	
	Если ИмяВида = "РегистрСведений" Тогда
		Возврат "РегистрыСведений";
	ИначеЕсли ИмяВида = "РегистрНакопления" Тогда
		Возврат "РегистрыНакопления";
	КонецЕсли;
	
	Возврат ИмяВида;
	
КонецФункции

Функция ИмяТипаМетаданныхДляФормы(ИмяКоллекции) Экспорт
	
	Если ИмяКоллекции = "Документы" Тогда
		Возврат "Документ";
	ИначеЕсли ИмяКоллекции = "Справочники" Тогда
		Возврат "Справочник";
	КонецЕсли;
	
	Возврат ИмяКоллекции;
	
КонецФункции

Функция СтрокаТипаИзОписанияТипа(ОписаниеТипа) Экспорт
	
	ТипыРеквизита = ОписаниеТипа.Типы();
	СтрокаТипа = "";
	
	Для Каждого ТипРеквизита Из ТипыРеквизита Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
		Если МетаданныеТипа = Неопределено Тогда
			Возврат Строка(ОписаниеТипа);
		Иначе
			СтрокаТипа = СтрокаТипа + ?(СтрокаТипа = "", "", "; ") + МетаданныеТипа.ПолноеИмя();
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокаТипа;
	
КонецФункции

Функция ПолучитьСсылкуТипа(СтрокаТипа) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаТипа) Тогда
		Возврат Справочники.рс_ТипыОбъектов.ПустаяСсылка();
	КонецЕсли;
	
	НаименованиеТипа = Лев(СокрЛП(СтрокаТипа), 200);
	СсылкаТипа = Справочники.рс_ТипыОбъектов.НайтиПоНаименованию(НаименованиеТипа, Истина);
	Если ЗначениеЗаполнено(СсылкаТипа) Тогда
		Возврат СсылкаТипа;
	КонецЕсли;
	
	НовыйЭлемент = Справочники.рс_ТипыОбъектов.СоздатьЭлемент();
	НовыйЭлемент.Наименование = НаименованиеТипа;
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Функция ПолучитьСсылкуРеквизита(ИмяРеквизита, СинонимРеквизита, СтрокаТипа) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат Справочники.рс_Реквизиты.ПустаяСсылка();
	КонецЕсли;
	
	НаименованиеРеквизита = Лев(СокрЛП(ИмяРеквизита), 250);
	СсылкаРеквизита = Справочники.рс_Реквизиты.НайтиПоНаименованию(НаименованиеРеквизита, Истина);
	Если ЗначениеЗаполнено(СсылкаРеквизита) Тогда
		Возврат СсылкаРеквизита;
	КонецЕсли;
	
	НовыйЭлемент = Справочники.рс_Реквизиты.СоздатьЭлемент();
	НовыйЭлемент.Наименование = НаименованиеРеквизита;
	НовыйЭлемент.Синоним = Лев(СокрЛП(СинонимРеквизита), 256);
	НовыйЭлемент.Тип = ПолучитьСсылкуТипа(СтрокаТипа);
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Функция ПолучитьОбъектРСПоИмениВИдентификаторах(Имя, ПолноеИмя = "") Экспорт
	
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Справочники.рс_Объекты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИдентификаторыОбъектовМетаданных.Имя КАК Имя,
		|	ИдентификаторыОбъектовМетаданных.ПолноеИмя КАК ПолноеИмя
		|ИЗ
		|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|ГДЕ
		|	ИдентификаторыОбъектовМетаданных.Имя = &Имя
		|	И НЕ ИдентификаторыОбъектовМетаданных.ПометкаУдаления";
	
	Если ЗначениеЗаполнено(ПолноеИмя) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя";
		Запрос.УстановитьПараметр("ПолноеИмя", ПолноеИмя);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Имя", Имя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Справочники.рс_Объекты.ПустаяСсылка();
	КонецЕсли;
	
	ВидОбъекта = ВидОбъектаРСПоПолномуИмени(Выборка.ПолноеИмя);
	Если Не ЗначениеЗаполнено(ВидОбъекта) Тогда
		Возврат Справочники.рс_Объекты.ПустаяСсылка();
	КонецЕсли;
	
	ПоискОбъект = НайтиОбъектРС(ВидОбъекта, Выборка.Имя);
	Если ЗначениеЗаполнено(ПоискОбъект) Тогда
		Возврат ПоискОбъект;
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(Выборка.ПолноеИмя);
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Справочники.рс_Объекты.ПустаяСсылка();
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("Индентификатор", МетаданныеОбъекта.Имя);
	Структура.Вставить("Наименование", МетаданныеОбъекта.Синоним);
	Структура.Вставить("Вид", ВидОбъекта);
	
	Возврат СоздатьОбъектРС(Структура);
	
КонецФункции

Функция ВидОбъектаРСПоПолномуИмени(ПолноеИмя) Экспорт
	
	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяВида = Части[0];
	
	Если ИмяВида = "Документ" Тогда
		Возврат Перечисления.рс_ВидыОбъектов.Документы;
	ИначеЕсли ИмяВида = "Справочник" Тогда
		Возврат Перечисления.рс_ВидыОбъектов.Справочники;
	ИначеЕсли ИмяВида = "РегистрСведений" Тогда
		Возврат Перечисления.рс_ВидыОбъектов.РегистрСведений;
	ИначеЕсли ИмяВида = "РегистрНакопления" Тогда
		Возврат Перечисления.рс_ВидыОбъектов.РегистрНакопления;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

 // Заполняет табличную часть объекта (или коллекцию строк с методами Очистить/Добавить) из значения параметра:
// ТаблицаЗначений; Массив / ФиксированныйМассив (элементы — Структура или строка с совпадающими именами колонок);
// либо коллекция с методом Выгрузить() (табличная часть, ДанныеФормыКоллекция и т.п.).
//
Процедура ЗаполнитьТабличнуюЧастьИзПараметра(ТабличнаяЧастьПриемник, Знач ИсточникДанных, ОчиститьПередЗаполнением = Истина) Экспорт
	
	Если ТабличнаяЧастьПриемник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОчиститьПередЗаполнением Тогда
		ТабличнаяЧастьПриемник.Очистить();
	КонецЕсли;
	
	Если ИсточникДанных = Неопределено Или ИсточникДанных = Null Тогда
		Возврат;
	КонецЕсли;
	
	ТипИсточника = ТипЗнч(ИсточникДанных);
	
	Если ТипИсточника = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаДанных Из ИсточникДанных Цикл
			НоваяСтрока = ТабличнаяЧастьПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если ТипИсточника = Тип("Массив") Или ТипИсточника = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из ИсточникДанных Цикл
			НоваяСтрока = ТабличнаяЧастьПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из ИсточникДанных Цикл
		НоваяСтрока = ТабличнаяЧастьПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсточникДанных);
	КонецЦикла;
	
КонецПроцедуры 

//Создает запись регистра НапоминанияПользователяУХ
//Структура содержит 
//Пользователь 		- спр. Пользователи
//Источник     		- Ссылка                          
//ТекстУведомления 	- текст
//ВидСобытия        - ВидСобытияОповещения
//ДопПараметры      - Структура 
//
Процедура ДобавитьУведомление(Структура) Экспорт
	
	СтруктураНапоминания = Новый Структура;
	СтруктураНапоминания.Вставить("Пользователь"				, Структура.Пользователь);
	СтруктураНапоминания.Вставить("ВремяСобытия"				, КонецДня(ТекущаяДата())); //Должно быть больще чем текущая дата
	СтруктураНапоминания.Вставить("Источник"					, Структура.Источник);                                                  
	СтруктураНапоминания.Вставить("ВидСобытияОповещения"		, Структура.ВидСобытия); 
	СтруктураНапоминания.Вставить("СрокНапоминания"				, НачалоДня(ТекущаяДата())); //Не должно быть пустым и меньше чем текущая дата
	СтруктураНапоминания.Вставить("ИнтервалВремениНапоминания"	, 3600*12);
	СтруктураНапоминания.Вставить("ВремяПоследнегоНапоминания"	, Дата(1,1,1));
	СтруктураНапоминания.Вставить("Описание"					, Структура.ТекстУведомления);
    //СтруктураНапоминания.Вставить("ДопПараметры"				, Структура.ДопПараметры);
	
	МодульУправленияОповещениямиУХ.ДобавитьНапоминаниеПользователяПоСтруктуре(СтруктураНапоминания);
	
КонецПроцедуры  

Функция ПолучитьКоличествоЭлементовИБ(Структура) Экспорт
	
	ТекстЗапроса = "";		
	ТекстЗАпроса = ТекстЗапроса + Строка("ВЫБРАТЬ " 
	+ СокрЛП(Структура.МетаданноеИмя) + ".Ссылка КАК Мет ИЗ "
	+ Структура.ДляЗапроса+"."
	+ СокрЛП(Структура.МетаданноеИмя) + " как " 
	+ СокрЛП(Структура.МетаданноеИмя)); 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		Результат = Запрос.Выполнить(); 
		Выборка = Результат.Выбрать();
		
		КК = 0;
		Пока Выборка.Следующий() Цикл
			КК = КК + 1; 
		КонецЦикла;			
	Исключение
	КонецПопытки;
	
	Возврат КК;  
	
КонецФункции 

&НаСервере
Функция ПолучитьАдресЭлПочты(Пользователь) Экспорт 
	
	АдресЭлПочты = Неопределено; 
	
	Если Пользователь.КонтактнаяИнформация.Количество() > 0 Тогда 
		Для Каждого СтрКИ из Пользователь.КонтактнаяИнформация Цикл 
			Если СтрКИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailПользователя Тогда
				АдресЭлПочты = СтрКИ.Представление;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	 
	Возврат АдресЭлПочты;
	 
КонецФункции



