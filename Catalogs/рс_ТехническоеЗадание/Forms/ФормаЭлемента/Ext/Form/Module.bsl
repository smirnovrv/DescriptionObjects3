&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	НоваяСтрока = Объект.Наблюдатели.Добавить();
   	НоваяСтрока.Сотрудник = ВыбранноеЗначение; 
		
	СформироватьСтрокуНаблюдатели(); 
	
	//ДобавитьУведомление(ВыбранноеЗначение);
	
	Модифицированность = Истина;

КонецПроцедуры  

&НаСервере
Процедура СформироватьСтрокуНаблюдатели()
	
   	 УЧС = Новый Массив;
	 Для Каждого СтрНаблюдатель Из Объект.Наблюдатели Цикл  
		 тНаблюдатель = Новый ФорматированнаяСтрока(Строка(СтрНаблюдатель.Сотрудник),,,,ПолучитьНавигационнуюСсылку(СтрНаблюдатель.Сотрудник));
		 УЧС.Добавить(тНаблюдатель);
		 УЧС.Добавить(" ");
	 КонецЦикла;	  
	 
	итСтрокаНаблюдатели = Новый ФорматированнаяСтрока(УЧС); 
	
	СтрокаНаблюдатели	= итСтрокаНаблюдатели;   
	
КонецПроцедуры 

