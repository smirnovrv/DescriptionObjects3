
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.ОписаниеЗадания) Тогда
		ЗаданиеДокумент.УстановитьHTML(Объект.ОписаниеЗадания, Новый Структура);
	КонецЕсли;
	
	ОбновитьЧат();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаданиеДокумент.ПолучитьHTML(ТекущийОбъект.ОписаниеЗадания, Новый Структура);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщение(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьСообщениеЗавершение", ЭтотОбъект);
	ОткрытьФорму(
		"Справочник.рс_Требования.Форма.ФормаВводаСообщения",
		Новый Структура,
		ЭтаФорма,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьСообщениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Результат.Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСообщениеНаСервере(Результат.Текст);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСообщениеНаСервере(ТекстСообщения)
	
	НоваяСтрока = Объект.Обсуждения.Добавить();
	НоваяСтрока.рс_Сообщение 	= СообщениеВСтрокуХранения(ТекстСообщения);
	НоваяСтрока.Автор 			= ПараметрыСеанса.ТекущийПользователь;
	НоваяСтрока.Дата 			= ТекущаяДатаСеанса();
	
	ОбновитьЧат();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЧат()
	
	МассивЭлементов = Новый Массив;
	
	Для Каждого СтрокаОбсуждения Из Объект.Обсуждения Цикл
		
		ФорматированнаяСтрокаСообщения = СообщениеИзСтрокиХранения(СтрокаОбсуждения.рс_Сообщение);
		Если ПустаяСтрока(Строка(ФорматированнаяСтрокаСообщения)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивЭлементов.Количество() > 0 Тогда
			МассивЭлементов.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));  
			МассивЭлементов.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
		МассивЭлементов.Добавить(ФорматированнаяСтрокаСообщения);
		
	КонецЦикла;
	
	Если МассивЭлементов.Количество() = 0 Тогда
		Чат = Новый ФорматированныйДокумент;
	Иначе
		ФорматированнаяСтрокаЧата = Новый ФорматированнаяСтрока(МассивЭлементов);
		Чат = Новый ФорматированныйДокумент;
		Чат.УстановитьФорматированнуюСтроку(ФорматированнаяСтрокаЧата); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СообщениеВСтрокуХранения(ТекстСообщения)
	
	Если ТипЗнч(ТекстСообщения) = Тип("ФорматированнаяСтрока") Тогда
		Возврат XMLСтрока(ТекстСообщения);
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

&НаСервере
Функция СообщениеИзСтрокиХранения(ЗначениеСообщения)
	
	Если ТипЗнч(ЗначениеСообщения) = Тип("ФорматированнаяСтрока") Тогда
		Возврат ЗначениеСообщения;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеСообщения) Тогда
		Возврат Новый ФорматированнаяСтрока("");
	КонецЕсли;
	
	Попытка
		Результат = XMLЗначение(Тип("Строка"), ЗначениеСообщения);
		Если ТипЗнч(Результат) = Тип("ФорматированнаяСтрока") Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		// Сообщение сохранено как обычная строка.
	КонецПопытки;
	
	Возврат Новый ФорматированнаяСтрока(Строка(ЗначениеСообщения));
	
КонецФункции
