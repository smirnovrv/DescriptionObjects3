 //НетКИ
 //КонтрагентОбмена - текущий Контрагент обмена
 //ПоискКонтрагент - Найденный КонтрагентРС 				
 //
 Процедура ЗаполнитьКИ(Структура)
	 
	 Для Каждого СтрКИКонтрагентОбмена Из Структура.КонтрагентОбмена.КонтактнаяИнформация Цикл 
		Отбор = Новый Структура; 
		Отбор.Вставить("Тип"			, СтрКИКонтрагентОбмена.Тип);
		Отбор.Вставить("Вид"			, СтрКИКонтрагентОбмена.Вид);
		Отбор.Вставить("Представление"	, СтрКИКонтрагентОбмена.Представление);   
		
		 МассивСтрок = Структура.ПоискКонтрагент.КонтактнаяИнформация.НайтиСтроки(Отбор); 
		 Если МассивСтрок.Количество() = 0 Тогда 
			  КонтрагентОбъект 	= Структура.ПоискКонтрагент.ПолучитьОбъект();
			  НоваяСтрока 		= КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			  ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрКИКонтрагентОбмена); 
			  КонтрагентОбъект.НетКИ = ложь;
			  КонтрагентОбъект.Записать();
		 КонецЕсли;		 
	 КонецЦикла;
	 
 КонецПроцедуры	 

&НаСервере
 Процедура ПустоеПредставлениеНаСервере()
	 
	 ВыборкаДетальныеЗаписи = РС_ОбщийМодульСервер.ПолучитьВыборкуКонтрагентовОбмен();  
	 
	 Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		 мУдалитьСтроки = Новый Массив;
		 Для Каждого СтрКИ Из ВыборкаДетальныеЗаписи.Ссылка.КонтактнаяИнформация Цикл
			 Если Не ЗначениеЗаполнено(СтрКИ.Представление) Тогда 
				 мУдалитьСтроки.Добавить(СтрКИ.НомерСтроки-1);
			 КонецЕсли;	
		 КонецЦикла;
		 Если Не мУдалитьСтроки.Количество() = 0 Тогда 
			 СпрОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			 к=0;
			 Для Каждого стрУдалитьСтроки из мУдалитьСтроки Цикл
				 СпрОбъект.КонтактнаяИнформация.Удалить(стрУдалитьСтроки-к);  
				 к=к+1;
			 КонецЦикла;
			 СпрОбъект.Записать();
		 КонецЕсли;	
	 КонецЦикла;
	 
 КонецПроцедуры
 
#КонецОбласти