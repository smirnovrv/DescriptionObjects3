&НаКлиенте
Процедура ОбъектРСПриИзменении(Элемент)
	ОчиститьНедопустимыеРеквизитыДействийНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура рс_Действиярс_РеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ОбъектРС) Тогда
		ПоказатьПредупреждение(, "Сначала выберите объект.");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	СписокРеквизитов = РеквизитыОбъектаРСДляВыбораНаСервере(Объект.ОбъектРС);
	
	Если СписокРеквизитов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "У выбранного объекта нет реквизитов в табличной части «Реквизиты».");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ДанныеВыбора = СписокРеквизитов;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНедопустимыеРеквизитыДействийНаСервере()
	
	ДопустимыеРеквизиты = РеквизитыОбъектаРСДляВыбораНаСервере(Объект.ОбъектРС);
	ДопустимыеСсылки = Новый Соответствие;
	
	Для Каждого ЭлементСписка Из ДопустимыеРеквизиты Цикл
		ДопустимыеСсылки.Вставить(ЭлементСписка.Значение, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаДействия Из Объект.рс_Действия Цикл
		Если ЗначениеЗаполнено(СтрокаДействия.рс_Реквизит)
			И ДопустимыеСсылки.Получить(СтрокаДействия.рс_Реквизит) = Неопределено Тогда
			СтрокаДействия.рс_Реквизит = Справочники.рс_Реквизиты.ПустаяСсылка();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РеквизитыОбъектаРСДляВыбораНаСервере(ОбъектРС)
	
	СписокРеквизитов = Новый СписокЗначений;
	
	Если Не ЗначениеЗаполнено(ОбъектРС) Тогда
		Возврат СписокРеквизитов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	рс_ОбъектыРеквизиты.Имя КАК Реквизит
		|ИЗ
		|	Справочник.рс_Объекты.рс_Реквизиты КАК рс_ОбъектыРеквизиты
		|ГДЕ
		|	рс_ОбъектыРеквизиты.Ссылка = &ОбъектРС
		|	И рс_ОбъектыРеквизиты.Имя <> ЗНАЧЕНИЕ(Справочник.рс_Реквизиты.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ОбъектРС", ОбъектРС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокРеквизитов.Добавить(Выборка.Реквизит, Строка(Выборка.Реквизит));
	КонецЦикла;
	
	Возврат СписокРеквизитов;
	
КонецФункции
