&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	
	Табл.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РС_ФизическиеЛицаКонтактнаяИнформация.Ссылка КАК Ссылка,
		|	РС_ФизическиеЛицаКонтактнаяИнформация.Ссылка.ФИО КАК ФИО,
		|	РС_ФизическиеЛицаКонтактнаяИнформация.Ссылка.ИНН КАК ИНН,
		|	РС_ФизическиеЛицаКонтактнаяИнформация.Вид КАК ВидКИ,
		|	РС_ФизическиеЛицаКонтактнаяИнформация.Тип КАК ТипКИ,
		|	РС_ФизическиеЛицаКонтактнаяИнформация.Представление КАК ПредставлениеКИ,
		|	РС_ФизическиеЛицаКонтактнаяИнформация.НомерСтроки КАК НомСтр
		|ИЗ
		|	Справочник.РС_ФизическиеЛица.КонтактнаяИнформация КАК РС_ФизическиеЛицаКонтактнаяИнформация
		|ГДЕ
		|	НЕ РС_ФизическиеЛицаКонтактнаяИнформация.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФИО,
		|	ИНН,
		|	ПредставлениеКИ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Таб = РезультатЗапроса.Выгрузить();
	Таб.Свернуть("ФИО, ИНН");
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИНН) Тогда 
			НоваяСтрока =  Табл.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		КонецЕсли;
	КонецЦикла;
	
    Табл2.Загрузить(Таб); 
	
КонецПроцедуры

