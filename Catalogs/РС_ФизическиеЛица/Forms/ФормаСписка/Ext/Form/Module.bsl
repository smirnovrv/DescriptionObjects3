&НаСервере
Процедура УдалитьДублиНаСервере()

	Для Каждого СтрТаб Из Табл2 Цикл 
		
		Структура = Новый Структура;
		Структура.Вставить("ФИО"	, СтрТаб.ФИО);
		Структура.Вставить("ИНН"	, СтрТаб.ИНН); 
		
		МассивСтрок = Табл.НайтиСтроки(Структура);
		
		текОбъект = Неопределено;
		Для Каждого СтрМассива Из МассивСтрок Цикл 
			Если текОбъект = Неопределено Тогда 
				текОбъект = СтрМассива.Ссылка;
				Продолжить;
			КонецЕсли;
			
			Если Не текОбъект = СтрМассива.Ссылка Тогда //Если Элемент массива не совподает 
				
				//Записываем в тек (общий)
				СправочникОбъект = текОбъект.ПолучитьОбъект(); 	
				
				//Найдем строку КИ в др. элементе
				СтрокаКИ 	= СтрМассива.Ссылка.КонтактнаяИнформация.Получить(СтрМассива.НомСтр-1);   
				
				//Тут надо проверить что такая строка есть или нет
				СтруктураКИ = Новый Структура;
				СтруктураКИ.Вставить("Вид"			,СтрМассива.ВидКИ);
				СтруктураКИ.Вставить("Тип"			,СтрМассива.ТипКИ);
				СтруктураКИ.Вставить("Представление",СтрМассива.ПредставлениеКИ);  
				масСтрок =  СправочникОбъект.КонтактнаяИнформация.НайтиСтроки(СтруктураКИ);
				
				Если масСтрок.Количество() = 0 Тогда 
					//Заполним Общ. строку из др. элемента
					НоваяСтрока = СправочникОбъект.КонтактнаяИнформация.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКИ);              	 
					СправочникОбъект.Записать(); 
					
					//Удалим др. элемент 
					Если СтрМассива.Ссылка.ПометкаУдаления = Ложь Тогда 
						СпрОбъект = СтрМассива.Ссылка.ПолучитьОбъект(); 
						СпрОбъект.ПометкаУдаления = Истина;
						СпрОбъект.Записать(); 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

