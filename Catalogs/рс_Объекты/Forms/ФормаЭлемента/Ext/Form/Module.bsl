&НаКлиенте
Перем ПоследняяСсылкаДетализации;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоследняяСсылкаДетализации = Неопределено;
	ПодключитьОбработчикОжидания("ОбновлятьДетализациюПоТекущейСтроке", 0.5);
	ОбновлятьДетализациюПоТекущейСтроке();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("ОбновлятьДетализациюПоТекущейСтроке");
КонецПроцедуры

&НаКлиенте
Процедура ОбновлятьДетализациюПоТекущейСтроке() Экспорт
	ТекущаяСтрока = Элементы.Расширения.ТекущиеДанные;
	НоваяСсылка = Неопределено;
	Если ТекущаяСтрока <> Неопределено Тогда
		НоваяСсылка = ТекущаяСтрока.Детализация;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НоваяСсылка) Тогда
		ПоследняяСсылкаДетализации = Неопределено;
		ТекстДетализации = "";
	КонецЕсли;

	Если СсылкиСовпадают(НоваяСсылка, ПоследняяСсылкаДетализации) Тогда
		Возврат;
	КонецЕсли;

	ПоследняяСсылкаДетализации = НоваяСсылка;
	ТекстФайла = ПолучитьТекстПрисоединенногоФайлаНаСервере(НоваяСсылка);
	ТекстДетализации = ТекстВHTMLДляПросмотраДетализации(ТекстФайла);
	
	Элементы.ПросмотрДетализации.Документ.activeElement.innerHTML = ТекстДетализации;
КонецПроцедуры

&НаКлиенте
Процедура РасширенияПриАктивизацииСтроки(Элемент)
	ОбновлятьДетализациюПоТекущейСтроке();
КонецПроцедуры

&НаКлиенте
Функция СсылкиСовпадают(ЛеваяСсылка, ПраваяСсылка)
	Если ЛеваяСсылка = Неопределено И ПраваяСсылка = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЛеваяСсылка = Неопределено Или ПраваяСсылка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЛеваяСсылка = ПраваяСсылка;
КонецФункции

&НаКлиенте
Функция ТекстВHTMLДляПросмотраДетализации(Знач ИсходныйТекст)
	Если Не ЗначениеЗаполнено(ИсходныйТекст) Тогда
		Возврат "";
	КонецЕсли;

	Э = СтрЗаменить(ИсходныйТекст, "&", "&amp;");
	Э = СтрЗаменить(Э, "<", "&lt;");
	Э = СтрЗаменить(Э, ">", "&gt;");
	Возврат "<html><head><meta charset=""utf-8""/></head><body><pre style=""white-space:pre-wrap;margin:0"">" + Э + "</pre></body></html>";
КонецФункции

&НаКлиенте
Процедура ЗагрузитьДетализациюИзФайла(Команда)
	ТекущаяСтрока = Элементы.Расширения.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Выберите строку табличной части Расширения.");
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите текстовый файл";
	Диалог.Фильтр = "Текстовые файлы (*.txt)|*.txt|Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	Попытка
		ТекстовыйДокумент.Прочитать(Диалог.ПолноеИмяФайла);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
	ФайлСсылка = СоздатьПрисоединенныйФайлНаСервере(Диалог.ПолноеИмяФайла, ТекстФайла);
	ТекущаяСтрока.Детализация = ФайлСсылка;
	ПоследняяСсылкаДетализации = Неопределено;
	ОбновлятьДетализациюПоТекущейСтроке();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОбщая(Команда)
	ЗаполнитьОбщаяНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбщаяНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Вид) Тогда
		Сообщить("Не заполнен реквизит Вид.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Индентификатор) Тогда
		Сообщить("Не заполнен реквизит Индентификатор.");
		Возврат;
	КонецЕсли;

	ИмяВида = Строка(Объект.Вид);
	Если Метаданные[ИмяВида] = Неопределено
		Или Метаданные[ИмяВида][Объект.Индентификатор] = Неопределено Тогда
		Сообщить("Метаданные объекта не найдены.");
		Возврат;
	КонецЕсли;

	Объект.рс_Общая.Очистить();

	Для Каждого Метаданное Из Метаданные[ИмяВида][Объект.Индентификатор].Реквизиты Цикл
		НоваяСтрока = Объект.рс_Общая.Добавить();
		НоваяСтрока.Синоним = Метаданное.Синоним;
		НоваяСтрока.Имя = Метаданное.Имя;
		НоваяСтрока.Вид = Перечисления.рс_ВидыПринадлежностиРеквизита.Объекта;

		ТипыРеквизита = Метаданное.Тип.Типы();
		СтрокаТипа = "";
		Для Каждого ТипРеквизита Из ТипыРеквизита Цикл
			МетаданныеТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
			Если МетаданныеТипа = Неопределено Тогда
				СтрокаТипа = Метаданное.Тип;
			Иначе
				СтрокаТипа = СтрокаТипа + ?(СтрокаТипа = "", "", "; ") + МетаданныеТипа.ПолноеИмя();
			КонецЕсли;
		КонецЦикла;

		НоваяСтрока.Тип = СтрокаТипа;
	КонецЦикла;

	Для Каждого МетаданноеТЧ Из Метаданные[ИмяВида][Объект.Индентификатор].ТабличныеЧасти Цикл
		ИмяТЧ = МетаданноеТЧ.Имя;
		СсылкаТЧ = Справочники.рс_ТабличныеЧасти.НайтиПоНаименованию(ИмяТЧ);
		Если Не ЗначениеЗаполнено(СсылкаТЧ) Тогда
			СсылкаТЧ = СоздатьТабличнуюЧастьРС(ИмяТЧ);
		КонецЕсли;

		Для Каждого МетаданныеРеквизитаТЧ Из МетаданноеТЧ.Реквизиты Цикл
			НоваяСтрока = Объект.рс_Общая.Добавить();
			НоваяСтрока.Синоним = МетаданныеРеквизитаТЧ.Синоним;
			НоваяСтрока.Имя = МетаданныеРеквизитаТЧ.Имя;
			НоваяСтрока.рс_ТабличнаяЧасть = СсылкаТЧ;
			НоваяСтрока.Вид = Перечисления.рс_ВидыПринадлежностиРеквизита.Объекта;

			ТипыРеквизита = МетаданныеРеквизитаТЧ.Тип.Типы();
			СтрокаТипа = "";
			Для Каждого ТипРеквизита Из ТипыРеквизита Цикл
				МетаданныеТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
				Если МетаданныеТипа = Неопределено Тогда
					СтрокаТипа = МетаданныеРеквизитаТЧ.Тип;
				Иначе
					СтрокаТипа = СтрокаТипа + ?(СтрокаТипа = "", "", "; ") + МетаданныеТипа.ПолноеИмя();
				КонецЕсли;
			КонецЦикла;

			НоваяСтрока.Тип = СтрокаТипа;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СоздатьТабличнуюЧастьРС(Знач ИмяТЧ)
	НовыйЭлемент = Справочники.рс_ТабличныеЧасти.СоздатьЭлемент();
	НовыйЭлемент.Наименование = ИмяТЧ;
	НовыйЭлемент.Записать();
	Возврат НовыйЭлемент.Ссылка;
КонецФункции

&НаСервере
Функция СоздатьПрисоединенныйФайлНаСервере(Знач ПолноеИмяФайла, Знач ТекстФайла)
	НовыйФайл 				= Справочники.рс_ПрисоединенныеФайлы.СоздатьЭлемент();
	текФайл 				= Новый Файл(ПолноеИмяФайла);
	НовыйФайл.Наименование 	= текФайл.Имя;
	НовыйФайл.ИмяФайла 		= ПолноеИмяФайла;
	НовыйФайл.Содержимое 	= Новый ХранилищеЗначения(ТекстФайла);
	НовыйФайл.Записать();

	Возврат НовыйФайл.Ссылка;
КонецФункции

&НаСервере
Функция ПолучитьТекстПрисоединенногоФайлаНаСервере(Знач СсылкаНаФайл)
	Если Не ЗначениеЗаполнено(СсылкаНаФайл) Тогда
		Возврат "";
	КонецЕсли;

	ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();
	Если ТипЗнч(ОбъектФайла.Содержимое) = Тип("ХранилищеЗначения") Тогда
		Возврат ОбъектФайла.Содержимое.Получить();
	КонецЕсли;

	Возврат "";
КонецФункции
