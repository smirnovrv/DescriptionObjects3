&НаКлиенте
Перем ПоследняяСсылкаДетализации;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоследняяСсылкаДетализации = Неопределено;
	ПодключитьОбработчикОжидания("ОбновлятьДетализациюПоТекущейСтроке", 0.5);
	ОбновлятьДетализациюПоТекущейСтроке();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("ОбновлятьДетализациюПоТекущейСтроке");
КонецПроцедуры

&НаКлиенте
Процедура ОбновлятьДетализациюПоТекущейСтроке() Экспорт
	ТекущаяСтрока = Элементы.Расширения.ТекущиеДанные;
	НоваяСсылка = Неопределено;
	Если ТекущаяСтрока <> Неопределено Тогда
		НоваяСсылка = ТекущаяСтрока.Детализация;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НоваяСсылка) Тогда
		ПоследняяСсылкаДетализации = Неопределено;
		ТекстДетализации = "";
	КонецЕсли;

	Если СсылкиСовпадают(НоваяСсылка, ПоследняяСсылкаДетализации) Тогда
		Возврат;
	КонецЕсли;

	ПоследняяСсылкаДетализации = НоваяСсылка;
	ТекстФайла = ПолучитьТекстПрисоединенногоФайлаНаСервере(НоваяСсылка);
	ТекстДетализации = ТекстВHTMLДляПросмотраДетализации(ТекстФайла);
	
	Элементы.ПросмотрДетализации.Документ.activeElement.innerHTML = ТекстДетализации;
КонецПроцедуры

&НаКлиенте
Процедура РасширенияПриАктивизацииСтроки(Элемент)
	ОбновлятьДетализациюПоТекущейСтроке();
КонецПроцедуры

&НаКлиенте
Функция СсылкиСовпадают(ЛеваяСсылка, ПраваяСсылка)
	Если ЛеваяСсылка = Неопределено И ПраваяСсылка = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЛеваяСсылка = Неопределено Или ПраваяСсылка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЛеваяСсылка = ПраваяСсылка;
КонецФункции

&НаКлиенте
Функция ТекстВHTMLДляПросмотраДетализации(Знач ИсходныйТекст)
	Если Не ЗначениеЗаполнено(ИсходныйТекст) Тогда
		Возврат "";
	КонецЕсли;

	Э = СтрЗаменить(ИсходныйТекст, "&", "&amp;");
	Э = СтрЗаменить(Э, "<", "&lt;");
	Э = СтрЗаменить(Э, ">", "&gt;");
	Возврат "<html><head><meta charset=""utf-8""/></head><body><pre style=""white-space:pre-wrap;margin:0"">" + Э + "</pre></body></html>";
КонецФункции

&НаКлиенте
Процедура ЗагрузитьДетализациюИзФайла(Команда)
	ТекущаяСтрока = Элементы.Расширения.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Выберите строку табличной части Расширения.");
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите текстовый файл";
	Диалог.Фильтр = "Текстовые файлы (*.txt)|*.txt|Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	Попытка
		ТекстовыйДокумент.Прочитать(Диалог.ПолноеИмяФайла);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
	ФайлСсылка = СоздатьПрисоединенныйФайлНаСервере(Диалог.ПолноеИмяФайла, ТекстФайла);
	ТекущаяСтрока.Детализация = ФайлСсылка;
	ПоследняяСсылкаДетализации = Неопределено;
	ОбновлятьДетализациюПоТекущейСтроке();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизиты(Команда)
	ЗаполнитьРеквизитыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФормы(Команда)   
	ЗаполнитьФормыНаКлиенте();	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФормыНаКлиенте()
	
	Объект.рс_Формы.Очистить();
	
	ИмяКоллекции = рс_ОбщийМодульСервер.ИмяКоллекцииМетаданныхПоВиду(Объект.Вид);
		
	ИменаРеквизитовОбъекта 	= ПолучитьСписокРеквизитовОбъекта(ИмяКоллекции); 
	ИменаФормОбъекта 		= ПолучитьСписокФормОбъекта(ИмяКоллекции);
	
	ИмяТипаДляФормы = рс_ОбщийМодульСервер.ИмяТипаМетаданныхДляФормы(ИмяКоллекции);
	
	Для Каждого стрФорма Из ИменаФормОбъекта Цикл 
		тИмяФормы 		= ИмяТипаДляФормы + "." + Объект.Индентификатор + ".Форма." + стрФорма;		
		СсылкаНаФорму 	= ПолучитьСсылкуНаФорму(стрФорма);
		Если Не ЗначениеЗаполнено(СсылкаНаФорму) Тогда
			СсылкаНаФорму = СоздатьФормуРС(стрФорма);
		КонецЕсли; 
		
		Попытка
			текФорма 		= ПолучитьФорму(тИмяФормы);  					
			массРеквизитов 	= текФорма.РеквизитыДокумента;
			Для Каждого РеквизитФормы Из текФорма.РеквизитыДокумента Цикл		
				Если ИменаРеквизитовОбъекта.Получить(РеквизитФормы.Ключ) = Истина Тогда
					Продолжить;
				КонецЕсли;  
				НоваяСтрока 				= Объект.рс_Формы.Добавить();
				НоваяСтрока.рс_Форма 		= СсылкаНаФорму;
				НоваяСтрока.ИмяРеквизита 	= РеквизитФормы.Ключ;	
			КонецЦикла;
		Исключение
			НоваяСтрока 				= Объект.рс_Формы.Добавить();
			НоваяСтрока.рс_Форма 		= СсылкаНаФорму;
		КонецПопытки;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуНаФорму(тИмяФормы)
    Возврат Справочники.рс_Формы.НайтиПоНаименованию(тИмяФормы);
КонецФункции

&НаСервере
Функция ПолучитьСписокРеквизитовОбъекта(ИмяВида)
	
	ИменаРеквизитовОбъекта = Новый Соответствие; 
	
	Для Каждого РеквизитОбъекта Из Метаданные[ИмяВида][Объект.Индентификатор].Реквизиты Цикл
		ИменаРеквизитовОбъекта.Вставить(РеквизитОбъекта.Имя, Истина);
	КонецЦикла;

	Возврат ИменаРеквизитовОбъекта;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокФормОбъекта(ИмяВида) 
	
	ИменаФормОбъекта = Новый Массив;
	
	Для Каждого МетаданноеФормы Из Метаданные[ИмяВида][Объект.Индентификатор].Формы Цикл 
		ИменаФормОбъекта.Добавить(МетаданноеФормы.Имя);		
	КонецЦикла;
	
	Возврат ИменаФормОбъекта;

КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Вид) Тогда
		Сообщить("Не заполнен реквизит Вид.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Индентификатор) Тогда
		Сообщить("Не заполнен реквизит Индентификатор.");
		Возврат;
	КонецЕсли;

	ИмяКоллекции = рс_ОбщийМодульСервер.ИмяКоллекцииМетаданныхПоВиду(Объект.Вид);
	Если Метаданные[ИмяКоллекции] = Неопределено
		Или Метаданные[ИмяКоллекции][Объект.Индентификатор] = Неопределено Тогда
		Сообщить("Метаданные объекта не найдены.");
		Возврат;
	КонецЕсли;

	Объект.рс_Реквизиты.Очистить();
	
	Структура = Новый Структура;
	Структура.Вставить("тВид", ИмяКоллекции);
	Структура.Вставить("ИД", Объект.Индентификатор);
	Структура.Вставить("Табл", Объект.рс_Реквизиты);
	Структура.Вставить("ТЧ", Неопределено);
	
	рс_ОбщийМодульСервер.ЗаполнитьРеквизитыРС(Структура);
	
	Для Каждого МетаданноеТЧ Из Метаданные[ИмяКоллекции][Объект.Индентификатор].ТабличныеЧасти Цикл
		ИмяТЧ = МетаданноеТЧ.Имя;
		СсылкаТЧ = Справочники.рс_ТабличныеЧасти.НайтиПоНаименованию(ИмяТЧ);
		Если Не ЗначениеЗаполнено(СсылкаТЧ) Тогда
			СсылкаТЧ = СоздатьТабличнуюЧастьРС(ИмяТЧ);
		КонецЕсли;
		
		Структура.Вставить("ТЧ", СсылкаТЧ);
		рс_ОбщийМодульСервер.ЗаполнитьРеквизитыРС(Структура);
	КонецЦикла;

	ЗаполнитьФормыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормыНаСервере()
	 //ЗаполнитьФормыНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормыКомандаНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Вид) Тогда
		Сообщить("Не заполнен реквизит Вид.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Индентификатор) Тогда
		Сообщить("Не заполнен реквизит Индентификатор.");
		Возврат;
	КонецЕсли;

	ИмяКоллекции = рс_ОбщийМодульСервер.ИмяКоллекцииМетаданныхПоВиду(Объект.Вид);
	Если Метаданные[ИмяКоллекции] = Неопределено
		Или Метаданные[ИмяКоллекции][Объект.Индентификатор] = Неопределено Тогда
		Сообщить("Метаданные объекта не найдены.");
		Возврат;
	КонецЕсли;

	ЗаполнитьФормыНаСервере();
КонецПроцедуры

&НаСервере
Функция СоздатьТабличнуюЧастьРС(Знач ИмяТЧ)
	НовыйЭлемент = Справочники.рс_ТабличныеЧасти.СоздатьЭлемент();
	НовыйЭлемент.Наименование = ИмяТЧ;
	НовыйЭлемент.Записать();
	Возврат НовыйЭлемент.Ссылка;
КонецФункции

&НаСервере
Функция СоздатьФормуРС(Знач ИмяФормы)
	НовыйЭлемент = Справочники.рс_Формы.СоздатьЭлемент();
	НовыйЭлемент.Наименование = ИмяФормы;
	НовыйЭлемент.Записать();
	Возврат НовыйЭлемент.Ссылка;
КонецФункции

&НаСервере
Функция СоздатьПрисоединенныйФайлНаСервере(Знач ПолноеИмяФайла, Знач ТекстФайла)
	НовыйФайл 				= Справочники.рс_ПрисоединенныеФайлы.СоздатьЭлемент();
	текФайл 				= Новый Файл(ПолноеИмяФайла);
	НовыйФайл.Наименование 	= текФайл.Имя;
	НовыйФайл.ИмяФайла 		= ПолноеИмяФайла;
	НовыйФайл.Содержимое 	= Новый ХранилищеЗначения(ТекстФайла);
	НовыйФайл.Записать();

	Возврат НовыйФайл.Ссылка;
КонецФункции

&НаСервере
Функция ПолучитьТекстПрисоединенногоФайлаНаСервере(Знач СсылкаНаФайл)
	Если Не ЗначениеЗаполнено(СсылкаНаФайл) Тогда
		Возврат "";
	КонецЕсли;

	ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();
	Если ТипЗнч(ОбъектФайла.Содержимое) = Тип("ХранилищеЗначения") Тогда
		Возврат ОбъектФайла.Содержимое.Получить();
	КонецЕсли;

	Возврат "";
КонецФункции
